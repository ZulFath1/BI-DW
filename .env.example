# =====================================================================
# Contoh konfigurasi. Salin menjadi .env lalu isi nilainya:
#     cp .env.example .env
# JANGAN commit .env (sudah ada di .gitignore).
#
# Kata sandi: gunakan huruf dan angka saja (tanpa @ : / ? # %), karena sebagian
# dipakai di dalam URL koneksi database.
# Contoh pembuat nilai acak (Python):
#     python -c "import secrets; print(secrets.token_hex(24))"
# Fernet key Airflow:
#     python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# =====================================================================

# --- PostgreSQL: superuser (hanya untuk inisialisasi & administrasi) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# --- Database data warehouse (schema stg, curated, dq, dw, mart) ---
DW_DB=posyandu_dw
ETL_USER=etl_user
ETL_PASSWORD=
# User read-only untuk dashboard (hanya SELECT pada dw dan mart)
DASHBOARD_USER=dashboard_ro
DASHBOARD_PASSWORD=

# --- Database metadata Airflow ---
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=

# --- Data lake (Silo, kompatibel S3/MinIO) ---
# User minimal 3 karakter, kata sandi minimal 8 karakter
LAKE_ROOT_USER=
LAKE_ROOT_PASSWORD=
LAKE_BUCKET_RAW=raw
LAKE_BUCKET_BACKUP=backup

# --- Airflow ---
AIRFLOW_UID=50000
# Login UI Airflow (Simple Auth Manager)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# --- Pseudonimisasi nama kader (kunci HMAC; jangan pernah dibagikan) ---
PSEUDONYM_KEY=
